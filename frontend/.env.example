# FlowGuard Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL
VITE_API_URL=https://flowguard-production.up.railway.app/api

# Bitcoin Cash Network
VITE_BCH_NETWORK=chipnet

# WalletConnect v2 Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=demo-project-id

# Enable the WizardConnect connector tile in the wallet picker.
# WizardConnect is a BCH-native dapp-to-wallet protocol (NIP-17 over WebSocket).
# Currently only Paytaca mobile (v0.24.x+) ships support. Pre-1.0 with active
# churn — leave disabled in production unless you've smoke-tested against the
# Cauldron relay (wss://relay.cauldron.quest:443) with a real Paytaca session.
# Default: false.
VITE_ENABLE_WIZARDCONNECT=false

# Enable the OPTN Wallet tile in the wallet picker.
# OPTN is a covenant-native BCH mobile wallet that acts as a WalletConnect v2 wallet.
# It advertises the same bch namespace FlowGuard requests and resolves CashScript
# covenant inputs via the same signature/pubkey placeholder patterns our builders emit,
# so it needs no new transport — but the pairing is unproven end to end and OPTN signs
# with its FIRST derived address only. Leave disabled in production until the Phase 1
# compatibility run produces mainnet txids.
# Default: false.
VITE_ENABLE_OPTN=false

# An https URL of a test network build, linked from /demo so people can try
# FlowGuard with coins that have no value. Leave unset and /demo never
# mentions the test network.
# VITE_TEST_APP_URL=https://chipnet.example.com
